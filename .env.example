# ─────────────────────────────────────────────────────────────────────────────
# Veles Scan — unified environment configuration
# Copy to .env and fill in your values before running ./start.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Network exposure policy ──────────────────────────────────────────────────
# Private services (API/DB/RabbitMQ/MinIO) are not published to host ports.
# UI is the only public endpoint by default.
PUBLIC_UI_BIND_IP=0.0.0.0

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=pipeline
RABBITMQ_PASSWORD=pipeline

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── OpenAI (required for intent-based project search) ─────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_PROXY=http://proxy:8080

# ── Session cookies ───────────────────────────────────────────────────────────
# For HTTPS deployments set APP_PUBLIC_URL to https://... or force secure cookie.
APP_PUBLIC_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false

# ── T-Bank internet acquiring (iframe widget) ───────────────────────────────
# Get values in T-Bank merchant account.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Optional explicit callback URL. If empty, APP_PUBLIC_URL + /api/payments/tbank/notification is used.
TBANK_NOTIFICATION_URL=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron schedule for automatic checko refresh (default: every 6 hours)
CHECKO_CRON="0 */6 * * *"

# ── Worker autoscaling (host-side autoscaler process) ────────────────────────
AUTO_SCALING_ENABLED=true
AUTOSCALE_POLL_INTERVAL_SEC=5
AUTOSCALE_SCALE_UP_COOLDOWN_SEC=5
AUTOSCALE_SCALE_DOWN_COOLDOWN_SEC=90

# Queue to observe for pipeline_worker scaling
AUTOSCALE_PIPELINE_QUEUE_NAME=jobs.pipeline.run

# pipeline_worker only: min/max replicas and queue target per worker
AUTOSCALE_PIPELINE_MIN_REPLICAS=1
AUTOSCALE_PIPELINE_MAX_REPLICAS=6
AUTOSCALE_PIPELINE_TARGET_MESSAGES_PER_WORKER=1

# Resource model for pipeline_worker autoscaling.
# A new worker starts only if host CPU and RAM headroom are sufficient.
AUTOSCALE_PIPELINE_CPU_PER_WORKER=1
AUTOSCALE_PIPELINE_MEMORY_MB_PER_WORKER=2048
AUTOSCALE_HOST_RESERVED_CPU=1
AUTOSCALE_HOST_RESERVED_MEMORY_MB=2048

# checko_worker is intentionally fixed to a single replica
